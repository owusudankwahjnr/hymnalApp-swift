      "predictiveBackGestureEnabled": false,
      "package": "com.owusudankwahjnr.hymnalapprn"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "90c1733a-2a2f-4a1f-9efd-c6b43ad3db43"
      }
